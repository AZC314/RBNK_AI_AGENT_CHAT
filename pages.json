{
	"vueVersion": "3",
	"pages": [{
			"path": "pages/message/message",
			"style": {
				"enablePullDownRefresh": true,
				// "backgroundTextStyle": "dark",
				"pullToRefresh": {
					"color": "#1890ff", // 下拉箭头颜色（仅H5/部分小程序）
					"background": "#F8F8F8" // 下拉区域背景色
				}
			}
		},
		{
			"path": "pages/address/address",
			"style": {
				"enablePullDownRefresh": true,
				// "backgroundTextStyle": "dark",
				"pullToRefresh": {
					"color": "#1890ff", // 下拉箭头颜色（仅H5/部分小程序）
					"background": "#F8F8F8" // 下拉区域背景色
				}
			}
		},
		{
			"path": "pages/chat/chat"
		},
		{
			"path": "pages/index/index"
		}
	],
	"globalStyle": {
		"navigationStyle": "custom"
	},
	"uniIdRouter": {},
	"tabBar": {
		"color": "#8f8f94",
		"selectedColor": "#0b8aff",
		"borderStyle": "black",
		"backgroundColor": "#ffffff",
		"list": [{
				"pagePath": "pages/message/message",
				"iconPath": "/static/tabbar/message.png",
				"selectedIconPath": "/static/tabbar/message_clinck.png",
				"text": "消息"
			},
			{
				"pagePath": "pages/address/address",
				"iconPath": "/static/tabbar/linkMan.png",
				"selectedIconPath": "/static/tabbar/linkMan_clinck.png",
				"text": "通讯录"
			}
		]
	}
}